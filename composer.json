{
    "name": "buting/cliapp-updater",
    "description": "Framework-independent PHP updater for the apps.cli.cc release and licensing service",
    "keywords": ["php", "updater", "incremental-update", "rollback", "thinkphp", "webman"],
    "homepage": "https://github.com/BuTingBa/cliapp-updater",
    "support": {
        "source": "https://github.com/BuTingBa/cliapp-updater",
        "issues": "https://github.com/BuTingBa/cliapp-updater/issues"
    },
    "type": "composer-plugin",
    "license": "proprietary",
    "authors": [{"name": "BuTing"}],
    "require": {
        "php": ">=7.2",
        "php-64bit": "*",
        "ext-curl": "*",
        "ext-hash": "*",
        "ext-json": "*",
        "ext-zip": "*",
        "composer-plugin-api": "^2.0"
    },
    "suggest": {"ext-sodium": "Required only for offline Ed25519 license verification"},
    "autoload": {"psr-4": {"BuTing\\CliAppUpdater\\": "src/"}},
    "bin": ["bin/cli-app-updater"],
    "scripts": {"test": "@php tests/run.php"},
    "archive": {"exclude": ["/tests", "/.github", "/.gitignore"]},
    "extra": {"class": "BuTing\\CliAppUpdater\\Composer\\Plugin"}
}
