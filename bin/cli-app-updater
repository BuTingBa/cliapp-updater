#!/usr/bin/env php
<?php

declare(strict_types=1);

use BuTing\CliAppUpdater\Updater;

require isset($_composer_autoload_path) ? $_composer_autoload_path : dirname(__DIR__) . '/autoload.php';

if ($argc < 2 || $argc > 3 || !in_array($argv[1], ['init', 'client-key', 'status', 'report', 'authorize', 'check', 'changelog', 'manifest', 'download', 'update', 'rollback'], true)) {
    fwrite(STDERR, "Usage: cli-app-updater <init|client-key|status|report|authorize|check|changelog|manifest|download|update|rollback> [updater.php]\n");
    exit(2);
}

try {
    if ($argv[1] === 'init') {
        $result = \BuTing\CliAppUpdater\Setup::initialize($argv[2] ?? getcwd());
        echo \BuTing\CliAppUpdater\Json::encode($result, JSON_PRETTY_PRINT | JSON_UNESCAPED_SLASHES) . "\n";
        exit(0);
    }
    $updater = Updater::fromFile($argv[2] ?? getcwd() . '/updater.php');
    $command = $argv[1];
    if ($command === 'client-key') {
        $result = ['client_key' => $updater->getClientKey()];
    } elseif ($command === 'update') {
        $result = $updater->update() ?? ['update' => false];
    } elseif ($command === 'rollback') {
        $updater->rollback();
        $result = ['rolled_back' => true] + $updater->status();
    } elseif (in_array($command, ['check', 'download', 'manifest'], true)) {
        $release = $updater->check();
        $result = Updater::summary($release);
        if ($command === 'download' && $release['update'] && !$release['installed']) {
            $result['downloaded_file'] = $updater->download($release);
        } elseif ($command === 'manifest' && $release['update']) {
            $result = $updater->manifest($release);
        }
    } else {
        $result = $updater->$command();
        unset($result['license_value']);
    }
    echo \BuTing\CliAppUpdater\Json::encode($result, JSON_PRETTY_PRINT | JSON_UNESCAPED_UNICODE | JSON_UNESCAPED_SLASHES) . "\n";
} catch (Throwable $error) {
    // No stack traces, request headers, API responses or nested hook errors in routine CLI output.
    fwrite(STDERR, $error->getMessage() . "\n");
    exit(1);
}
